The semantics are subtler than my first probe: `.all(0)` asks corner-*uniformity* in **every** frame of the window, not equality across frames. A window that contains even one corner-non-uniform frame loses promotion. Fixing both probes:
[0m$ [0mALGAN_USE_DAEMON=0 ALGAN_RENDER_DEVICE=cpu uv run python - <<'EOF' 2>&1 | tail -40
import os
assert os.environ.get("ALGAN_RENDER_DEVICE") == "cpu"
import torch
from algan.rendering.raytracing.scene_builder import _split_promotable
from algan.mobs.surfaces.surface import surface_closed_axes, surface_weld_flags

class P: pass

def make_p(T):
    # Corner-uniform colour while static; corner GRADIENT (non-uniform) once
    # the "animation" starts at frame 3.
    colors = torch.full((T, 1, 3, 5), 0.5)
    for f in range(3, T):
        colors[f, :, 0, 0] = 0.5          # corner 0 stays
        colors[f, :, 1, 0] = 0.5 + 0.02 * f
        colors[f, :, 2, 0] = 0.5 + 0.04 * f
    extra = torch.zeros(T, 1, 15)
    p = P(); p._rt_tri_colors = colors; p._rt_tri_extra = extra
    return p

scene = {}; tex_off=[0]
def append_texture(tex, is_color=False):
    o=tex_off[0]; tex_off[0]+=1; return (o,1,1)

for T in (3, 6, 19):
    tex_off[0]=0; scene.clear()
    keep, promo, meta = _split_promotable(make_p(T), append_texture, torch.device("cpu"), scene)
    print(f"T={T}: kept={keep.numel()} promoted={promo.numel()}")

# --- weld / closed axes: seam gap grows past tol only later in the timeline ---
W,H = 12,6
gap_per_frame = 5e-5   # frames 0..2 stay under 1e-4; by frame ~10 it exceeds
grids=[]
for f in range(19):
    g = gap_per_frame * f
    col0 = torch.zeros(H,3); colN = torch.zeros(H,3); colN[:,0]=g
    grids.append(torch.stack([torch.lerp(col0,colN,w) for w in torch.linspace(0,1,W)],0))
grid_full = torch.stack(grids)
print("wrap_x full-19:", surface_weld_flags(grid_full)[0],
      " first-3:", surface_weld_flags(grid_full[:3])[0])
print("closed_u full:", surface_closed_axes(grid_full)[0],
      " first-3:", surface_closed_axes(grid_full[:3])[0])

# --- needs_endpoint: vertex count couples frames ---
from algan.rendering.raytracing.primitives import _bezier_connection_visibility
EOF

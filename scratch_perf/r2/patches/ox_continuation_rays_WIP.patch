+# a counting launch is literally a different kernel variant from the shipping
+# one, and none of its timings are shipping numbers.
+
+# Weight-bucket edges, doubling from MIN_WEIGHT; the last bucket is unbounded.
+_SC_W_EDGES = tuple(
+    1e-3 * (2.0**k) for k in range(SC_W_BUCKETS - 1)
+) + (float("inf"),)
+# At-birth visibility bucket edges.
+_SC_S_EDGES = (0.05, 0.5, 0.95)

+@ti.func
+def _sc_weight_bucket(wmax):
+    b = 0
+    for i in ti.static(range(SC_W_BUCKETS - 1)):
+        if wmax >= _SC_W_EDGES[i]:
+            b = i + 1
+    return b
+
+
+@ti.func
+def _sc_vis_bucket(vis_sum):
+    b = 0
+    for i in ti.static(range(len(_SC_S_EDGES))):
+        if vis_sum >= _SC_S_EDGES[i]:
+            b = i + 1
+    return b
+
+

+    if ti.static(counting != 0):
+        vis_sum = 0.0
+        for s in ti.static(range(_AA_NUM_SAMPLES)):
+            vis_sum += svis[s]
+        ti.atomic_add(
+            rs_alloc[ALLOC_SC0 + kind * SC_W_BUCKETS + _sc_weight_bucket(wmax)],
+            1)
+        ti.atomic_add(
+            rs_alloc[ALLOC_SC0 + SC_N_KINDS * SC_W_BUCKETS
+                     + kind * SC_S_BUCKETS + _sc_vis_bucket(vis_sum)],
+            1)

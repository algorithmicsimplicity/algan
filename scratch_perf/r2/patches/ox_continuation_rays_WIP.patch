+# ---------------------------------------------------------------------------
+# Diagnostics-only spawn counters (scratch profiling of the sheet resolve's
+# continuation births; the host-side reader/formatter is
+# ``rendering.raytracing.spawn_counts``). Every atomic add into these slots is
+# behind a ``ti.static`` counting gate in the one kernel that writes them, so
+# a shipping launch never touches this block -- it only pays the extra words,
+# which is why they ride ``rs_alloc`` instead of being kernel arguments (the
+# shade kernels are at Taichi's argument ceiling).
+# ---------------------------------------------------------------------------
+#: First counter word. Layout: per-kind x weight-bucket histogram, then
+#: per-kind x at-birth-visibility bucket, then the misc words below.
+ALLOC_SC0 = 3
+#: Continuation kinds, in histogram order: prefilter glossy row, reflection,
+#: refraction/transmission, primary that became its own bounce.
+SC_N_KINDS = 4
+#: Weight buckets are log2-spaced from ``MIN_WEIGHT`` up, edges at
+#: 1e-3 * 2**k for k in 0..10, plus an overflow bucket.
+SC_W_BUCKETS = 12
+#: At-birth visibility buckets: [<0.05, <0.5, <0.95, >=0.95].
+SC_S_BUCKETS = 4
+#: Misc words after the histograms: pixels walked, primaries retired without
+#: bouncing, retired on exhausted weight, retired at the far clip, and
+#: prefilter-glossy claims.
+SC_N_MISC = 5
+#: Number of ``rs_alloc`` words the diagnostics block occupies.
+ALLOC_SC_N = SC_N_KINDS * SC_W_BUCKETS + SC_N_KINDS * SC_S_BUCKETS + SC_N_MISC
+#: Misc word: covered pixels the resolve walked.
+SC_M_PIXELS = ALLOC_SC0 + SC_N_KINDS * (SC_W_BUCKETS + SC_S_BUCKETS)
+#: Misc word: primaries that retired instead of continuing as a bounce
+#: (mostly walks that ran out of sheets or weight; a bounce the compositing
+#: ceiling truncates lands here too).
+SC_M_RETIRE_WALK = SC_M_PIXELS + 1
+#: Misc word: walks cut by the running weight falling under ``MIN_WEIGHT``.
+SC_M_RETIRE_WEIGHT = SC_M_PIXELS + 2
+#: Misc word: walks cut by the camera's far clip.
+SC_M_RETIRE_FARCLIP = SC_M_PIXELS + 3
+#: Misc word: pixels that claimed their one split-sum glossy event.
+SC_M_GLOSS_CLAIMS = SC_M_PIXELS + 4
 #: Number of ``rs_alloc`` words the host must allocate and zero.
-ALLOC_WIDTH = 3
+ALLOC_WIDTH = 3 + ALLOC_SC_N
 
 

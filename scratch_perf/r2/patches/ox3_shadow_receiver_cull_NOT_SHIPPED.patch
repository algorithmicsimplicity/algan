diff --git a/algan/rendering/raytracing/settings.py b/algan/rendering/raytracing/settings.py
index 26f6ba25..59d1fbb5 100644
--- a/algan/rendering/raytracing/settings.py
+++ b/algan/rendering/raytracing/settings.py
@@ -783,6 +783,66 @@ def shadow_terminator_mode():
     return 2 if SHADOW_TERMINATOR == 2 else 1
 
 
+# Receiver-facing whole-fan shadow cull: skip a (shadow event, light) fan
+# entirely when the receiver's shading normal AND its face normal both face
+# away from the light's centre. The per-sample horizon guard in
+# ``raster_shadow_trace`` / ``wavefront_shade`` already declines to MARCH such
+# samples; this cull additionally skips the fan setup and sample loop, and --
+# unlike the horizon guard -- it also covers SOFT fans (a light with a
+# ``shadow_radius``, an area light's cell rows), where some samples of the fan
+# can face the emitter and get traced even though the stage multiplies their
+# result by zero.
+#
+# Soundness is per STAGE, not per kernel. Every consumer of the shadow-visibility
+# payload is a built-in fragment stage or ``direct_specular_lobe``, and in every
+# one of them each vis-multiplied term carries ``max(n . ld, 0)`` as an exact
+# factor, with ``ld`` the direction to the light row's centre -- the SAME vector
+# the cull tests (lambert/phong: diffuse; phong/standard/physical: diffuse and
+# every specular lobe explicitly re-multiplied by ``n_dot_l``; toon:
+# ``ceil(clamp(n.l, 0, 1) * bands) / bands``, exactly zero at ``n.l <= 0``).
+# Forcing the visibility to its all-lit default therefore changes no pixel for
+# those stages whatever the fan would have returned. It does NOT hold for
+#
+# * ``ManimMaterial`` (pipeline id 0), whose offset is ``0.5 * d**3`` HALVED
+#   when negative -- deliberately nonzero past the horizon, so its lit terms
+#   are NOT multiplied by zero and its fans stay exact (the kernels exclude it
+#   by id), and
+# * user fragment pipelines (>= _USER_PIPELINE_BASE), which may read visibility
+#   arbitrarily and already keep exact fans under the ``fan_exact`` gate.
+#
+# The cull tests the ORIENTED normals (the ones ``event_snrm``/``event_fnrm``
+# carry, flipped toward the viewer by ``_orient_hit_normals``). For two-sided
+# geometry that is the side the stages light from; on one-sided geometry shaded
+# from behind (reachable only through transparency) the stage lights with the
+# UNFLIPPED normal while this cull sees the flipped one -- the same documented
+# divergence the shipped horizon cull lives with (see
+# ``shading_taichi._sided_shading_normal``'s KNOWN LIMIT), so such a point was
+# already rendered unshadowed whenever its whole fan failed the horizon test.
+# Requiring BOTH normals keeps a flat-shading blend (which lies between them)
+# on the safe side of zero.
+SHADOW_RECEIVER_CULL = env_flag("ALGAN_SHADOW_RECEIVER_CULL", True)
+
+
+def set_shadow_receiver_cull(enabled):
+    """Toggle the receiver-facing whole-fan shadow cull (see
+    ``SHADOW_RECEIVER_CULL``). Takes effect at the next render batch.
+    """
+    global SHADOW_RECEIVER_CULL
+    SHADOW_RECEIVER_CULL = bool(enabled)
+
+
+def shadow_receiver_cull_gate():
+    """Live receiver-facing cull gate as an int (0/1).
+
+    Read at call time and returned as an int because it reaches the two shadow
+    kernels as a TEMPLATE value: each gate value compiles its own variant (see
+    ``shadow_terminator_mode``). Named ``..._gate`` because the SETTINGS
+    object's attribute resolution maps the field name
+    (``SETTINGS.raytracing.shadow_receiver_cull``) to the bool itself.
+    """
+    return 1 if SHADOW_RECEIVER_CULL else 0
+
+
 # The acceptance floor a shadow ray keeps against its OWN primitive, as a
 # fraction of the batch's scene scale (the diagonal of the merged triangle
 # bounding box over every frame of the batch). This is what retires the last

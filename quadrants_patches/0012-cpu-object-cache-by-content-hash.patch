+// Writes the object file the JIT compiles for a kernel module to the path its module identifier names, when that
+// identifier carries kObjectPathPrefix (JITSessionCPU::add_kernel_module sets it); other modules are left alone. The
+// file is written beside and renamed into place, so a process reading it never sees part of one. Reading is not done
+// here: add_kernel_module looks the file up before it builds the module at all, which is what lets it skip the IR.
+class KernelObjectWriter : public llvm::ObjectCache {
+ public:
+  static constexpr char kObjectPathPrefix[] = "quadrants-cpu-object:";
+
+  void notifyObjectCompiled(const llvm::Module *M, llvm::MemoryBufferRef obj) override {
+    const std::string &id = M->getModuleIdentifier();
+    const std::string prefix = kObjectPathPrefix;
+    if (id.compare(0, prefix.size(), prefix) != 0) {
+      return;
+    }
+    const std::filesystem::path path = id.substr(prefix.size());
+    std::error_code ec;
+    std::filesystem::create_directories(path.parent_path(), ec);
+    const std::filesystem::path tmp =
+        path.string() + fmt::format(".{}.{}.tmp", PID::get_pid(), tmp_counter_.fetch_add(1));
+    {
+      std::ofstream fs(tmp, std::ios::out | std::ios::binary);
+      if (!fs.is_open()) {
+        QD_DEBUG("Cannot write the CPU object cache file {}", tmp.string());
+        return;
+      }
+      fs.write(obj.getBufferStart(), (std::streamsize)obj.getBufferSize());
+      if (!fs) {
+        fs.close();
+        std::filesystem::remove(tmp, ec);
+        return;
+      }
+    }
+    std::filesystem::rename(tmp, path, ec);
+    if (ec) {
+      // Another process put the same object there first and it is open (Windows refuses to replace it then); the key
+      // determines the bytes, so theirs serves.
+      std::filesystem::remove(tmp, ec);
+    } else {
+      QD_DEBUG("Stored the CPU object of a kernel in {}", path.string());
+    }
+  }
+
+  std::unique_ptr<llvm::MemoryBuffer> getObject(const llvm::Module *) override {
+    return nullptr;
+  }
+
+ private:
+  std::atomic<uint64_t> tmp_counter_{0};
+};

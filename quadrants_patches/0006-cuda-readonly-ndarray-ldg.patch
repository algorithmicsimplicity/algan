+  // CUDA: load an ndarray argument through the non-coherent (read-only) cache -- `ld.global.nc`, the `__ldg` path
+  // read-only SNodes already take -- when nothing in the offloaded task writes or atomically updates that argument.
+  // Sound on the same assumption the SNode path makes, that distinct arguments do not alias: two ndarrays bound to
+  // overlapping memory, one written and one read in the same task, would read stale bytes. Off restores the plain
+  // load for A/B; in the offline cache key so the two arms never share a compiled artifact.
+  bool readonly_ndarray_ldg{true};
   bool demote_dense_struct_fors;
   bool advanced_optimization;
   bool constant_folding;

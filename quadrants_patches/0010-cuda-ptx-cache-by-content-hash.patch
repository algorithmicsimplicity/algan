+std::string PtxCache::make_content_cache_key(const std::string &content_hash, bool use_fast_math) const {
+  // Everything compile_module_to_ptx reads besides the module: the target, fast_math (its TargetOptions), and the code
+  // doing the lowering. 'C' where make_cache_key's keys start with 'T', so the two kinds cannot collide in a directory.
+  const std::string material =
+      fmt::format("ptx-by-content-hash/{};sm_{};fast_math={};llvm={};quadrants={}+{};content={}", kContentKeyRevision,
+                  compute_capability_, use_fast_math ? 1 : 0, LLVM_VERSION_STRING, get_version_string(),
+                  get_commit_hash(), content_hash);
+  picosha2::hash256_one_by_one hasher;
+  hasher.process(material.begin(), material.end());
+  hasher.finish();
+  auto res = picosha2::get_hash_hex_string(hasher);
+  res.insert(res.begin(), 'C');
+  return res;
+}

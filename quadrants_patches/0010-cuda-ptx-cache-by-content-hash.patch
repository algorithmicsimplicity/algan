+JITModule *JITSessionCUDA::add_kernel_module(const std::string &content_key,
+                                             bool module_from_file,
+                                             const std::function<std::unique_ptr<llvm::Module>()> &make_module) {
+  // The debugging paths want the module itself -- IR and PTX dumps, PTX swapped in from a dump, printed IR or PTX --
+  // so they keep add_module's IR-keyed path.
+  const bool debugging = get_environ_config(DUMP_IR_ENV.data()) != 0 || get_environ_config(LOAD_PTX_ENV.data()) != 0 ||
+                         config_.print_kernel_llvm_ir || config_.print_kernel_llvm_ir_optimized ||
+                         config_.print_kernel_asm;
+  if (!config_.offline_cache_ptx_by_content_hash || content_key.empty() || debugging) {
+    return add_module(make_module(), 0);
+  }
+  const std::string key = ptx_cache_->make_content_cache_key(content_key, config_.fast_math);
+  if (std::optional<std::string> cached = ptx_cache_->load_ptx(key)) {
+    QD_DEBUG("PTX for content hash {} served from the PTX cache ({})", content_key, key);
+    return load_ptx_module(*cached, 0);
+  }
+  auto module = make_module();
+  std::string ptx = compile_module_to_ptx(module, /*ir_key=*/module_from_file);
+  ptx_cache_->store_ptx(key, ptx);
+  QD_DEBUG("PTX for content hash {} stored in the PTX cache ({})", content_key, key);
+  return load_ptx_module(ptx, 0);
+}

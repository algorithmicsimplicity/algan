-                        auto smgr = std::make_unique<SectionMemoryManager>();
+                      [&, reserve_alloc = JTMB.getTargetTriple().isOSBinFormatCOFF()](const MemoryBuffer &) {
+                        auto smgr = std::make_unique<SectionMemoryManager>(/*MM=*/nullptr, reserve_alloc);
                         memory_manager_ = smgr.get();
                         return smgr;
                       }),

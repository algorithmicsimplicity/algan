+    } else if (op == UnaryOpType::exp) {
+      if (input_quadrants_type->is_primitive(PrimitiveTypeID::f32)) {
+        // expf has fast-math option, the same shape as log / sin / cos above. `__nv_fast_expf` is libdevice's `__expf`
+        // (one `ex2.approx` on a scaled input); its error is 2 ulp plus one per unit of |x|, so a `qd.exp(-20.0)`
+        // attenuation term lands ~25 ulp off the correctly rounded value -- of a piece with `__nv_fast_sinf`'s
+        // range-dependent bound, and a last-bit change on every kernel that calls it.
+        llvm_val[stmt] = call(compile_config.fast_math ? "__nv_fast_expf" : "__nv_expf", input);
+      } else if (input_quadrants_type->is_primitive(PrimitiveTypeID::f64)) {
+        llvm_val[stmt] = call("__nv_exp", input);
+      } else if (input_quadrants_type->is_primitive(PrimitiveTypeID::i32)) {
+        llvm_val[stmt] = call("exp", input);
+      } else {
+        QD_ERROR("exp() for type {} is not supported", input_quadrants_type.to_string());
+      }

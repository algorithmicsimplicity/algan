+std::string sanitize_shader_name(const std::string &name) {
+  std::string out;
+  for (char c : name) {
+    const bool keep = isalnum((unsigned char)c) || c == '_' || c == '.' || c == '-';
+    out.push_back(keep ? c : '_');
+  }
+  return out;

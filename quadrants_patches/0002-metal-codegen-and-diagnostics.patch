+// Write `size` bytes to <QD_SHADER_DUMP_DIR>/<name><suffix>; returns the path
+// written, or "" when no directory was named or the write failed. Never raises:
+// a diagnostic that can take down the thing it instruments is worse than no
+// diagnostic.
+std::string dump_shader_artifact(const std::string &name, const char *suffix, const void *bytes, size_t size) {
+  const std::string dir = shader_dump_dir();
+  if (dir.empty()) {
+    return std::string();
+  }
+  const std::string path = dir + "/" + sanitize_shader_name(name) + suffix;
+  std::ofstream out(path, std::ios::binary);
+  if (!out) {
+    return std::string();
+  }
+  out.write(reinterpret_cast<const char *>(bytes), static_cast<std::streamsize>(size));
+  return out ? path : std::string();

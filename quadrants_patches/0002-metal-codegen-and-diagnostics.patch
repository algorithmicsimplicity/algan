+// task's own name and every failure below says where. (`QD_DUMP_MSL` prints the
+// MSL of a shader that compiled; this is for the ones that did not.)
+std::string shader_dump_dir() {
+  const char *dir = std::getenv("QD_SHADER_DUMP_DIR");
+  return dir == nullptr ? std::string() : std::string(dir);

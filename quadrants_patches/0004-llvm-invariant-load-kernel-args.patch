+  auto *args_ptr_load = mark_invariant_arg_load(builder->CreateLoad(llvm::PointerType::get(args_type, 0), args_ptr),
+                                                callable);
+  // `get_struct_arg` re-emits this whole chain for every argument access rather than caching it, so this is the load
+  // that decides whether the rest hoist: with the metadata LLVM can CSE the repeats and lift them out of the loop.
+  // The host allocates exactly `args_size` bytes for the buffer (LaunchContextBuilder), so `!dereferenceable` is exact
+  // rather than a lower bound, and it is what keeps the load speculatable once it has been hoisted.
+  if (compile_config.invariant_arg_loads && callable->args_size > 0) {

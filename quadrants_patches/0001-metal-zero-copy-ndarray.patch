@@ -1287,6 +1287,14 @@ DeviceAllocation MetalDevice::import_mtl_buffer(MTLBuffer_id buffer) {
   out.alloc_id = reinterpret_cast<uint64_t>(&alloc);
   return out;
 }
+DeviceAllocation import_external_mtl_buffer(Device *device, uint64_t handle) {
+  MetalDevice *metal_device = dynamic_cast<MetalDevice *>(device);
+  if (metal_device == nullptr || handle == 0) {
+    return kDeviceNullAllocation;
+  }
+  return metal_device->import_mtl_buffer((MTLBuffer_id)(void *)handle);
+}

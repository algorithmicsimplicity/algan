+// Adopt an externally-owned MTLBuffer (torch's, say) as a DeviceAllocation.
+//
+// A thin wrapper around MetalDevice::import_mtl_buffer, and it exists for a
+// linkage reason rather than a design one. `MTLBuffer_id` is `id<MTLBuffer>` in
+// an Objective-C++ translation unit and `struct MTLBuffer_t *` in a plain C++
+// one (see DEFINE_METAL_ID_TYPE at the top of this header), so the two
+// spellings of `import_mtl_buffer` mangle differently and a .cpp caller would
+// not link against the .mm definition. Taking the buffer as an integer handle
+// gives both sides the same signature.
+//
+// Returns kDeviceNullAllocation if `device` is not a MetalDevice.
+DeviceAllocation import_external_mtl_buffer(Device *device, uint64_t handle);
+
 }  // namespace metal
 }  // namespace quadrants::lang

+class ExternalMetalNdarray(Ndarray):
+    """A Quadrants ndarray over an ``MTLBuffer`` this process did not allocate.
+
+    Built to let a torch MPS tensor reach a kernel without the host round trip
+    the launch path otherwise does for it: an argument that arrives as an
+    ``Ndarray`` is bound by device allocation, while a torch tensor on a
+    non-matching arch is copied to the host before the launch and copied back
+    after (``set_arg_ext_array``).
+
+    Args:
+        dtype (DataType): SCALAR element type -- ``qd.f16``, not
+            ``qd.types.vector(4, qd.f16)``. A vector or matrix element is asked
+            for through ``element_shape``, exactly as ``VectorNdarray`` and
+            ``MatrixNdarray`` build theirs.
+        arr_shape (Tuple[int]): OUTER shape, in elements. For a vector-element
+            array this excludes the element dimensions, so an array a kernel
+            annotates ``ndarray(dtype=vector(4, f16), ndim=2)`` has a 2-tuple
+            here and ``element_shape=(4,)``.
+        buffer_handle (int): the ``id<MTLBuffer>`` as an integer. For torch,
+            ``tensor.untyped_storage().data_ptr()`` -- **not** ``data_ptr()``,
+            which is that object pointer with the storage offset added to it.
+        byte_offset (int): where the array starts inside the buffer. For torch,
+            ``tensor.storage_offset() * tensor.element_size()``.
+        element_shape (Tuple[int]): the element's own dimensions, ``()`` for a
+            scalar element. Quadrants type-checks an ndarray argument against
+            the annotation's element type, so an array a kernel wants as
+            ``vector(4, f16)`` is rejected outright when it arrives as ``f16``
+            -- which is why this cannot be inferred from the buffer.
+
+    The buffer is **adopted, not owned**: Quadrants will not free it, and the
+    caller has to keep the owning object alive for at least as long as this
+    ndarray, or the allocator underneath may recycle the buffer while a kernel
+    is reading it.
+    """
+
+    def __init__(self, dtype, arr_shape, buffer_handle, byte_offset=0, element_shape=()):
+        super().__init__()
+        self.dtype = cook_dtype(dtype)
+        self._element_shape = tuple(int(d) for d in element_shape)
+        if self._element_shape:
+            # The same construction VectorNdarray/MatrixNdarray use: the element
+            # type is a tensor type over the scalar dtype, and it is what
+            # `create_ndarray_from_metal_buffer` is handed. `Ndarray`'s
+            # DeviceAllocation constructor reads the element shape back off it,
+            # so the C++ side needs nothing beyond a tensor DataType here.
+            self.element_type = DataTypeCxxWrapper(
+                _qd_core.get_type_factory_instance().get_tensor_type(self._element_shape, self.dtype).get_ptr()
+            )
+        else:
+            self.element_type = dtype
+        self.arr = impl.get_runtime().prog.create_ndarray_from_metal_buffer(
+            cook_dtype(self.element_type), list(arr_shape), int(buffer_handle), int(byte_offset)
+        )
+        # `shape` is a read-only property derived from this; the base class
+        # `__del__` is what hands `self.arr` back to `Program::delete_ndarray`.
+        self._physical_shape = tuple(self.arr.shape)
+
+    @property
+    def element_shape(self):
+        return self._element_shape
+
+    def _fill_by_kernel(self, val):
+        from quadrants._kernels import fill_ndarray  # pylint: disable=C0415
+
+        fill_ndarray(self, val)
+
+    def __repr__(self):
+        return "<qd.ndarray (imported MTLBuffer)>"
+

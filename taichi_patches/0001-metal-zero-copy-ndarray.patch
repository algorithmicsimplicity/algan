+Ndarray *Program::create_ndarray_from_metal_buffer(
+    const DataType type,
+    const std::vector<int> &shape,
+    uint64_t buffer_handle,
+    uint64_t byte_offset) {
+#ifdef TI_WITH_METAL
+  Device *device = program_impl_->get_compute_device();
+  TI_ERROR_IF(device == nullptr,
+              "no compute device: cannot import a Metal buffer");
+  DeviceAllocation devalloc =
+      metal::import_external_mtl_buffer(device, buffer_handle);
+  TI_ERROR_IF(devalloc.device == nullptr,
+              "the compute device is not a Metal device, or the buffer handle "
+              "was null: cannot import a Metal buffer");
+  auto arr = std::make_unique<Ndarray>(devalloc, type, shape);
+  arr->buffer_offset = byte_offset;
+  arr->owns_imported_allocation = true;
+  auto arr_ptr = arr.get();
+  ndarrays_.insert({arr_ptr, std::move(arr)});
+  return arr_ptr;
+#else
+  TI_ERROR("this Taichi was built without the Metal backend");
+#endif
+}

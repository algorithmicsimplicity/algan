+class ExternalMetalNdarray(Ndarray):
+    """A Taichi ndarray over an ``MTLBuffer`` this process did not allocate.
+
+    Built to let a torch MPS tensor reach a kernel without the host round trip
+    ``kernel_impl`` otherwise does for it: an argument that arrives as an
+    ``Ndarray`` is bound by device allocation, while a torch tensor on a
+    non-matching arch is copied to the host before the launch and copied back
+    after (``set_arg_ext_array``).
+
+    Args:
+        dtype (DataType): element type.
+        arr_shape (Tuple[int]): shape, in elements.
+        buffer_handle (int): the ``id<MTLBuffer>`` as an integer. For torch,
+            ``tensor.untyped_storage().data_ptr()`` -- **not** ``data_ptr()``,
+            which is that object pointer with the storage offset added to it.
+        byte_offset (int): where the array starts inside the buffer. For torch,
+            ``tensor.storage_offset() * tensor.element_size()``.
+
+    The buffer is **adopted, not owned**: Taichi will not free it, and the
+    caller has to keep the owning object alive for at least as long as this
+    ndarray, or the allocator underneath may recycle the buffer while a kernel
+    is reading it.
+    """
+
+    def __init__(self, dtype, arr_shape, buffer_handle, byte_offset=0):
+        super().__init__()
+        self.dtype = cook_dtype(dtype)
+        self.arr = impl.get_runtime().prog.create_ndarray_from_metal_buffer(
+            self.dtype, list(arr_shape), int(buffer_handle), int(byte_offset)
+        )
+        self.shape = tuple(self.arr.shape)
+        self.element_type = dtype
+
+    def __del__(self):
+        if impl is not None and impl.get_runtime() is not None and impl.get_runtime().prog is not None:
+            impl.get_runtime().prog.delete_ndarray(self.arr)
+
+    @property
+    def element_shape(self):
+        return ()
+
+    def _fill_by_kernel(self, val):
+        from taichi._kernels import fill_ndarray  # pylint: disable=C0415
+
+        fill_ndarray(self, val)
+
+    def __repr__(self):
+        return "<ti.ndarray (imported MTLBuffer)>"
+
+
 class NdarrayHostAccessor:
     def __init__(self, ndarray):
         dtype = ndarray.element_data_type()

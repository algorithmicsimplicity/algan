+
+llvm::LoadInst *TaskCodeGenLLVM::mark_invariant_arg_load(llvm::LoadInst *load, const Callable *callable) {
+  if (!compile_config.invariant_arg_loads) {
+    return load;
+  }
+  // Not for a Function (@qd.real_func) callee. A kernel's argument buffer is filled by the host before the launch and
+  // nothing in the module writes to it, which is what makes the metadata true. A callee's buffer is an `alloca` in its
+  // *caller*, written by set_args_ptr / set_struct_to_buffer immediately before the call (visit(FuncCallStmt)) -- so
+  // once the callee is inlined the store and these loads sit in one function, and `!invariant.load` would license LLVM
+  // to move a load above the store that initializes it. Silently reading uninitialized stack, at some later O3.
+  if (dynamic_cast<const Function *>(callable) != nullptr) {
+    return load;
+  }
+  // Volatility is not a concern here the way it is for the read-only SNode path (`create_global_load`'s QD_ASSERT):
+  // `qd.volatile_load` lowers to GlobalLoadStmt and never reaches the argument buffer.
+  load->setMetadata(llvm::LLVMContext::MD_invariant_load, llvm::MDNode::get(builder->getContext(), {}));
+  return load;
 }
 

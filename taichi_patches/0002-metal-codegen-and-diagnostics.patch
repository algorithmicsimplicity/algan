+// Where a generated shader may be written for inspection, or "" if nobody
+// asked. Metal reports `program_source:<line>:<col>` against MSL that nothing
+// has ever printed, and a shader that fails BEFORE any MSL exists -- SPIR-V
+// spirv-cross declines to parse, say -- leaves even less than that behind. So
+// when TI_SHADER_DUMP_DIR names a directory, both halves go to disk under the
+// task's own name and every failure below says where.
+std::string shader_dump_dir() {
+  const char *dir = std::getenv("TI_SHADER_DUMP_DIR");
+  return dir == nullptr ? std::string() : std::string(dir);
+}
+
+std::string sanitize_shader_name(const std::string &name) {
+  std::string out;
+  for (char c : name) {
+    const bool keep = isalnum((unsigned char)c) || c == '_' || c == '.' ||
+                      c == '-';
+    out.push_back(keep ? c : '_');
+  }
+  return out;
+}
+
+// Write `size` bytes to <TI_SHADER_DUMP_DIR>/<name><suffix>; returns the path
+// written, or "" when no directory was named or the write failed. Never
+// raises: a diagnostic that can take down the thing it instruments is worse
+// than no diagnostic.
+std::string dump_shader_artifact(const std::string &name,
+                                 const char *suffix,
+                                 const void *bytes,
+                                 size_t size) {
+  const std::string dir = shader_dump_dir();
+  if (dir.empty()) {
+    return std::string();
+  }
+  const std::string path = dir + "/" + sanitize_shader_name(name) + suffix;
+  std::ofstream out(path, std::ios::binary);
+  if (!out) {
+    return std::string();
+  }
+  out.write(reinterpret_cast<const char *>(bytes),
+            static_cast<std::streamsize>(size));
+  return out ? path : std::string();
+}
+
+// One line naming the task, how far it got, and where its shader was written.
+// Every "could not build a pipeline" path ends here, because the failure this
+// exists for arrives at `bind_pipeline` as a null pointer with no name
+// attached and the name is most of what a reader needs.
+void log_pipeline_failure(const std::string &name,
+                          const char *stage,
+                          const std::string &detail,
+                          size_t msl_bytes,
+                          const std::string &dump_path) {
+  std::string report = "cannot build a compute pipeline for task '" + name +
+                       "': " + stage;
+  if (!detail.empty()) {
+    report += ": " + detail;
+  }
+  if (msl_bytes != 0) {
+    report += " [msl " + std::to_string(msl_bytes) + " bytes]";
+  }
+  if (!dump_path.empty()) {
+    report += " [dumped to " + dump_path + "]";
+  }
+  RHI_LOG_ERROR(report.c_str());
+}
+

@@ -1224,7 +1224,28 @@ Value IRBuilder::cast(const SType &dst_type, Value value) {
                          get_primitive_type(get_unsigned_type(to)), ret);
       }
 
-      ret = make_value(spv::OpBitcast, dst_type, ret);
+      // Step 2 is a no-op whenever `to` already has the signedness step 1
+      // produced -- i64 -> i32, the commonest narrowing there is -- and
+      // emitting OpBitcast between two identical type ids is not harmless on
+      // every consumer. SPIRV-Cross renders the pair as a NESTED functional
+      // cast, `int(long(x))`, and MSL then cannot parse the result where it
+      // is bound to a temporary and used in an expression:
+      //
+      //     int tmp16_i32 = (int(long(_76))) * 8;
+      //     error: indirection requires pointer operand ('int' invalid)
+      //
+      // `int(long(_76))` is C++'s most vexing parse -- the function type
+      // `int(long)` with a parameter named `_76` -- so `(...) * 8` reads as a
+      // cast applied to a dereference. With the redundant bitcast gone the
+      // expression is `int(_76)`, which cannot be a type-id because `_76` is
+      // not a type name, and it parses as the conversion it is.
+      //
+      // The guard is the same one this function already opens with (`if
+      // (value.stype.id == dst_type.id) return value;`), applied to the
+      // second step as well.
+      if (ret.stype.id != dst_type.id) {
+        ret = make_value(spv::OpBitcast, dst_type, ret);
+      }
     }
 
     return ret;

+namespace {
+
+// Print the lines of `source` that `diagnostic` names, with context.
+//
+// Metal's messages carry `program_source:<line>:<col>`; each one gets a
+// numbered +/-6 line window. A message that names no line at all falls back to
+// the first 40 lines, which at least identifies the shader.
+void log_msl_source_context(const std::string &source,
+                            const std::string &diagnostic) {
+  std::vector<std::string> lines;
+  std::string current;
+  for (char c : source) {
+    if (c == '\n') {
+      lines.push_back(current);
+      current.clear();
+    } else {
+      current.push_back(c);
+    }
+  }
+  lines.push_back(current);
+
+  std::set<int> wanted;
+  const std::string marker = "program_source:";
+  for (size_t at = diagnostic.find(marker); at != std::string::npos;
+       at = diagnostic.find(marker, at + marker.size())) {
+    size_t digits = at + marker.size();
+    int line = 0;
+    while (digits < diagnostic.size() && isdigit((unsigned char)diagnostic[digits])) {
+      line = line * 10 + (diagnostic[digits] - '0');
+      ++digits;
+    }
+    if (line > 0) {
+      for (int i = std::max(1, line - 6);
+           i <= std::min((int)lines.size(), line + 6); ++i) {
+        wanted.insert(i);
+      }
+    }
+  }
+  if (wanted.empty()) {
+    for (int i = 1; i <= std::min((int)lines.size(), 40); ++i) {
+      wanted.insert(i);
+    }
+  }
+
+  std::string report = "the MSL Metal rejected (" +
+                       std::to_string(lines.size()) + " lines total):";
+  int previous = 0;
+  for (int line : wanted) {
+    if (previous != 0 && line != previous + 1) {
+      report += "\n  ...";
+    }
+    report += "\n  " + std::to_string(line) + " | " + lines[line - 1];
+    previous = line;
+  }
+  RHI_LOG_ERROR(report.c_str());
+}
